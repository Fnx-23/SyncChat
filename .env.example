# Copy to .env and adjust. .env is gitignored.
DJANGO_SECRET_KEY=replace-me-with-a-real-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# PostgreSQL (the only supported database; create the role and database first,
# see README). DB_PASSWORD must be set — there is no default.
DB_NAME=syncchat_db
DB_USER=syncchat_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional: point the channel layer and the rate-limit cache at Redis for
# multi-process/production deployments. Requires `channels-redis` and
# `django-redis` to be installed (see requirements-dev.txt).
# REDIS_URL=redis://127.0.0.1:6379/0
